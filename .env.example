# ──────────────────────────────────────────
# AgintX Website — Environment Variables
# Copy to .env.local and fill in values
# ──────────────────────────────────────────

# SMTP — for sending demo request emails to contact@agintx.com
# Supports any SMTP provider: SendGrid, Postmark, AWS SES, etc.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here

# (Optional) Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
